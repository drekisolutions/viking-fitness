{
  "expo": {
    "name": "Viking Fitness",
    "slug": "viking-fitness",
    "version": "1.0.20",
    "orientation": "portrait",
    "scheme": "vikingfitness",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drekilabs.vikingfitness",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Viking Fitness uses the camera to scan food barcodes for nutrition logging."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      },
      "package": "com.vikingfitness.myapp",
      "versionCode": 10020
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "66b7059a-065b-43d8-aa13-6ffac05ed0e3"
      }
    },
    "owner": "dreki_solutions"
  }
}
