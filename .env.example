# Viking Fitness — environment template. Copy to `.env` and fill in real values.
# Only EXPO_PUBLIC_* vars are bundled into the client; keep everything else out
# of the app. Server secrets live in the Supabase project, not here.

# --- Client (Expo, safe to ship in the bundle) ------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# RevenueCat PUBLIC SDK keys (per platform)
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxx
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxx
# Optional: web deployment base URL (used for Stripe redirects on web)
EXPO_PUBLIC_APP_URL=https://viking-fitness-pink.vercel.app
# Optional: PostHog product analytics (leave unset to disable)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Supabase Edge Function secrets (NOT client vars) -----------------------
# Set with: supabase secrets set KEY=value --project-ref <ref>
# Do NOT put these in this file for a real deploy — they are documented here
# only so the required set is discoverable.
#   STRIPE_SECRET_KEY=sk_live_xxx
#   STRIPE_MONTHLY_PRICE_ID=price_xxx
#   STRIPE_ANNUAL_PRICE_ID=price_xxx
#   STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
#   STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
#   STRIPE_WEBHOOK_SECRET=whsec_xxx
#   REVENUECAT_WEBHOOK_AUTH=<long-random-string>
#   APP_BASE_URL=https://viking-fitness-pink.vercel.app
# Auto-injected by Supabase (do not set): SUPABASE_URL, SUPABASE_ANON_KEY,
#   SUPABASE_SERVICE_ROLE_KEY
